# Copy this file to .env.local and fill in your Mindbody sandbox values.
# Never commit the resulting .env.local file.
MINDBODY_API_KEY=
MINDBODY_STAFF_TOKENS_JSON={"00000000-0000-4000-8000-000000000000":"staff-token"}
# One entry per Mindbody webhook subscription. The signature key is returned
# only by subscription creation and must remain server-side.
MINDBODY_WEBHOOK_SUBSCRIPTIONS_JSON=[{"integrationId":"00000000-0000-4000-8000-000000000000","siteId":"-99","signatureKey":"replace-with-subscription-signature-key"}]
CLASS_LIFECYCLE_WORKER_SECRET=replace-with-at-least-32-random-characters
MINDBODY_SANDBOX_SITE_ID=
MINDBODY_BASE_URL=https://api.mindbodyonline.com/public/v6
MINDBODY_ENVIRONMENT=sandbox
REVVI_APPOINTMENT_PROTOTYPE_ENABLED=true
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# The public callback Edge Function and customer page used only by an approved
# per-Business SCA checkout configuration. Never add payment credentials here.
BOOKING_SCA_CALLBACK_URL=http://127.0.0.1:54321/functions/v1/prototype-appointment-callback
BOOKING_SCA_RETURN_URL=http://127.0.0.1:3000/availability.html
